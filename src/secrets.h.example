#pragma once

#include <stdint.h>

// Template for secrets.h — copy this file to secrets.h and fill in real values.
// secrets.h is gitignored so your credentials never enter version control.
static const char* WIFI_SSID = "your-wifi-ssid";
static const char* WIFI_PASSWORD = "your-wifi-password";

// --- MQTT broker (server-side pipeline lives in broker/) ---
static const char*    MQTT_HOST      = "192.168.x.x"; // broker machine's LAN IP
static const uint16_t MQTT_PORT      = 1883;
// Device name: becomes the topic segment monitor-air/<id>/telemetry and the
// InfluxDB `device` tag. Allowed chars: A-Z a-z 0-9 _ - (no spaces / + #).
static const char*    MQTT_DEVICE_ID = "sensor-01";
// AS7341 ambient spectrum: 1 = stream mode:"ambient" each publish (a fixed monitoring
// node); set 0 on a roving reflectance-only probe so it emits only mode:"reflect".
#define PUBLISH_AMBIENT_SPECTRUM 1
// Optional broker auth — leave both empty for an anonymous broker.
static const char*    MQTT_USER      = "";
static const char*    MQTT_PASS      = "";

// --- s3cam (thermal-imaging head, env:s3cam) — OPTIONAL overrides ---
// The cam board joins whatever network you're on (hotel/hotspot when away);
// leave these out and it uses WIFI_SSID/WIFI_PASSWORD above.
// #define S3CAM_WIFI_SSID "your-hotspot"
// #define S3CAM_WIFI_PASS "your-hotspot-password"

// --- OTA (flash over WiFi) ---
// REQUIRED: main.cpp calls ArduinoOTA.setPassword(OTA_PASSWORD) unconditionally,
// so a secrets.h without it does not compile. Export the same value as OTA_PASS
// when uploading: `export OTA_PASS='...' && pio run -e ota -t upload --upload-port <ip>`
static const char*    OTA_PASSWORD   = "change-me";
