apiVersion: 1

# Deadman: one multi-dimensional rule that fires per (device, field) when that
# series hasn't reported for too long. New devices/fields are covered with no
# extra config. Threshold 15 min sits comfortably above the BH1750's transient
# gaps, so this pages only on a genuine sustained outage — the dashboard's 5-min
# table is the fine-grained view.
#
# Annotations are written as SENTENCES, in Chinese, with the number and its unit
# inline. They are the entire notification: the Telegram contact point renders
# summary + description and nothing else, so anything the reader needs has to be
# here. Grafana's default.message (labels dumped as `- k = v`, plus `C=1` from the
# threshold expression) is what this replaces.
#
# The staleness queries below therefore report MINUTES, not seconds. The
# notification template engine has no humanizeDuration — verified against this
# Grafana (11.1.0), which answers `function "humanizeDuration" not defined` — so
# the unit conversion has to happen where the number is produced. The thresholds
# then read in the same unit as the prose (15, 60), which is the point.
groups:
  - orgId: 1
    name: device-health
    folder: Device health
    interval: 1m
    rules:
      - uid: deadman-sensor-stale
        title: Sensor stale — device/field silent
        condition: C
        for: 2m
        # NOT OK. This rule's whole job is to notice silence, so treating "the
        # query returned nothing" as healthy makes it unable to report its own
        # failure — which is exactly what happened: a broken query read as green
        # for weeks while staging-01/temp had been dead 12 days.
        noDataState: NoData
        execErrState: Error
        labels:
          severity: warning
        annotations:
          summary: '{{ $labels.device }} 的 {{ $labels.field }} 停止回報'
          description: '已經 {{ printf "%.0f" $values.B.Value }} 分鐘沒有新資料（門檻 15 分）。檢查裝置電源與感測器接線。'
        data:
          - refId: A
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: influxdb-monitor-air
            model:
              refId: A
              datasource:
                type: influxdb
                uid: influxdb-monitor-air
              query: |
                import "date"
                import "timezone"
                option location = timezone.location(name: "Asia/Taipei")
                minofday = date.hour(t: now()) * 60 + date.minute(t: now())
                from(bucket: "sensors")
                  |> range(start: -30d)
                  // Only continuously-reporting PRODUCTION series belong in a deadman.
                  //   * `sim` is the synthetic publisher.
                  //   * `staging-01` is the bench board — it runs only while someone is
                  //     developing on it, so silence is its normal state, not an outage.
                  //     (Its env fields were one 12-minute bring-up on 2026-07-17 and are
                  //     retired; watching them means a permanent false alarm.)
                  //   * `weight_raw` is event-driven since station Phase 2: a weigh happens
                  //     on an NFC tap (measure/event_raw -> plant_weight), so a gap means
                  //     "nobody weighed anything", not "the scale died". Excluded by field
                  //     so it stays excluded if a production station ever publishes it.
                  // Alert fatigue is how a deadman dies — a rule that always fires is a
                  // rule nobody reads.
                  |> filter(fn: (r) => r._measurement == "air"
                       and r.device != "sim" and r.device != "staging-01"
                       and r._field != "weight_raw")
                  // BH1750 light fields (lux, lux_ref) drop out in darkness, which is
                  // normal — only alert on them inside the plant-light operating
                  // window; other fields 24/7. The window comes from broker/.env
                  // (LIGHT_WINDOW_*_MIN, minutes since midnight) — the SAME vars the
                  // light controller uses, so it stays in sync automatically.
                  |> filter(fn: (r) => (r._field != "lux" and r._field != "lux_ref") or (minofday >= $LIGHT_WINDOW_START_MIN and minofday < $LIGHT_WINDOW_END_MIN))
                  |> group(columns: ["device", "_field"])
                  |> last()
                  // Rebuild each row as a one-point series whose value is the age
                  // in MINUTES (ns / 60e9) — the notification prose quotes this
                  // number directly and there is no unit conversion downstream.
                  // Three things here are load-bearing; each one broke this rule
                  // silently before:
                  //   * `_time` must be present, or Grafana's Flux datasource has no
                  //     series to give the reduce below and yields NoData.
                  //   * `_time` must be now(), NOT the last report time — an old
                  //     point falls outside relativeTimeRange (600s), so the STALEST
                  //     series would be exactly the ones that disappear.
                  //   * the field name must NOT be carried as `_field`: Grafana treats
                  //     that as the frame's field NAME rather than a label, so every
                  //     series from one device collapses to {device=...} and the rule
                  //     dies with "frame cannot uniquely be identified by its labels".
                  //     Carried as plain `field` — annotations use $labels.field.
                  |> map(fn: (r) => ({ device: r.device, field: r._field, _time: now(),
                       _value: float(v: int(v: now()) - int(v: r._time)) / 60000000000.0 }))
                  |> group(columns: ["device", "field"])
          - refId: B
            datasourceUid: __expr__
            model:
              refId: B
              type: reduce
              datasource:
                type: __expr__
                uid: __expr__
              expression: A
              reducer: last
          - refId: C
            datasourceUid: __expr__
            model:
              refId: C
              type: threshold
              datasource:
                type: __expr__
                uid: __expr__
              expression: B
              conditions:
                - evaluator:
                    type: gt
                    # minutes — see the unit note at the top of this file
                    params: [15]

      # Watches the alerting path itself. It cannot warn you WHILE Telegram is down —
      # a single channel can never announce its own failure — so its job is the
      # retrospective one: the moment delivery recovers, this fires and tells you
      # that warnings were raised and lost, and when. On 2026-08-08 that window was
      # five hours and 89 dropped notifications, and the sensor outage underneath it
      # went unnoticed for two days.
      - uid: alert-delivery-failing
        title: Alert delivery failing — notifications are being dropped
        condition: C
        for: 5m
        # OK, unlike the deadman rules — and this one was wrong at first. The two
        # counters carry an `integration` label, so Grafana does not create them
        # until the first notification attempt after a restart: verified on
        # 2026-08-10, /metrics served 220 alerting series while these two were
        # absent entirely. NoData therefore means "Grafana restarted and has not
        # tried to notify yet", which is benign and transient, not a failure.
        # Treating it as an alert would fire after every restart.
        # Scrape health is covered elsewhere: the ingest-completeness panel shows
        # these series going flat if Telegraf stops collecting them.
        noDataState: OK
        execErrState: Error
        labels:
          severity: critical
        annotations:
          summary: '通知送不出去（{{ $labels.integration }}）'
          description: '過去 1 小時有 {{ printf "%.0f" $values.B.Value }} 則通知投遞失敗。這段期間觸發的警報沒有任何人收到 — 回頭查那段時間的 alert 歷史。原因通常是對外網路路徑，不是 token。'
        data:
          - refId: A
            relativeTimeRange:
              from: 3600
              to: 0
            datasourceUid: influxdb-monitor-air
            model:
              refId: A
              datasource:
                type: influxdb
                uid: influxdb-monitor-air
              query: |
                from(bucket: "sensors")
                  |> range(start: -1h)
                  |> filter(fn: (r) => r._measurement == "grafana_alerting_notifications_failed_total")
                  |> filter(fn: (r) => r._field == "counter")
                  |> group(columns: ["integration"])
                  // nonNegative: a Grafana restart zeroes the counter, and without
                  // this that reads as a large negative and the rule goes quiet
                  // exactly when the service has just come back.
                  |> difference(nonNegative: true)
                  |> sum()
                  |> map(fn: (r) => ({ integration: r.integration, _time: now(), _value: r._value }))
                  |> group(columns: ["integration"])
          - refId: B
            datasourceUid: __expr__
            model:
              refId: B
              type: reduce
              datasource: {type: __expr__, uid: __expr__}
              expression: A
              reducer: last
          - refId: C
            datasourceUid: __expr__
            model:
              refId: C
              type: threshold
              datasource: {type: __expr__, uid: __expr__}
              expression: B
              conditions:
                - evaluator:
                    type: gt
                    params: [0]

      # Second deadman, for the one ingest path that is NOT a device: the Open-Meteo
      # poll. It went dark for 11 h on 2026-08-03 and was noticed by eye, because the
      # rule above only covers `air`. Separate rule rather than a broadened filter —
      # the cadence and therefore the threshold are completely different.
      - uid: deadman-weather-stale
        title: Weather feed stale — Open-Meteo
        condition: C
        for: 10m
        # NoData here means the weather measurement has nothing in 30 days, i.e. the
        # feed is not merely late but gone. That must page, not read as healthy.
        noDataState: NoData
        execErrState: Error
        labels:
          severity: warning
        annotations:
          summary: 'Open-Meteo 天氣資料中斷'
          description: '已經 {{ printf "%.0f" $values.B.Value }} 分鐘沒有新的 weather 資料（門檻 60 分）。Telegraf 每 5 分鐘輪詢一次，Open-Meteo 偶發 503，所以這代表持續失敗而不是單次漏接 — 看 docker logs monitor-air-telegraf | grep 503。'
        data:
          - refId: A
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: influxdb-monitor-air
            model:
              refId: A
              datasource:
                type: influxdb
                uid: influxdb-monitor-air
              query: |
                from(bucket: "sensors")
                  |> range(start: -30d)
                  |> filter(fn: (r) => r._measurement == "weather")
                  // The feed is all-or-nothing — one JSON object, every field lands
                  // together — so collapse to ONE series instead of alerting six times
                  // for a single outage. Same shape rules as the rule above: stamp
                  // _time at now(), and never carry the label as `_field`.
                  |> group()
                  |> last()
                  |> map(fn: (r) => ({ feed: "open-meteo", _time: now(),
                       _value: float(v: int(v: now()) - int(v: r._time)) / 60000000000.0 }))
                  |> group(columns: ["feed"])
          - refId: B
            datasourceUid: __expr__
            model:
              refId: B
              type: reduce
              datasource:
                type: __expr__
                uid: __expr__
              expression: A
              reducer: last
          - refId: C
            datasourceUid: __expr__
            model:
              refId: C
              type: threshold
              datasource:
                type: __expr__
                uid: __expr__
              expression: B
              conditions:
                - evaluator:
                    type: gt
                    # minutes. 60 = four missed 15-min slots at a 5-min poll
                    # cadence — well clear of the routine 503s, which now cost
                    # 5 min at most.
                    params: [60]

      # The third failure class: telemetry that ARRIVES, on time, correctly
      # formatted, and is wrong. Neither deadman above can see it. On 2026-08-10
      # the BH1750 published 4,840 points topping out at 9.2 lux with the lamp on;
      # on 2026-08-11 16:00 the AS7341's visible channels fell ~100x within the
      # hour and stayed there for two days. Both feeds looked perfectly healthy.
      #
      # What makes a plausibility check possible here is that the lamp is a
      # CONTROLLED REFERENCE SOURCE: this room gets almost no daylight (measured
      # 1-2% of the daily total), so during lamp hours the illumination is fixed
      # and known. Two sensors sit in the same box looking at it through their own
      # quartz windows, so their RATIO is a property of the optics alone —
      # independent of how bright the light happened to be.
      #
      # Ratio rather than the absolute reading, and the data decided this:
      #   * absolute `clear` in the lamp window swings with daylight and lamp
      #     runtime — 30,834 (08-04) vs 37,459 (08-09) is +21% of weather, not of
      #     optics. A band loose enough to tolerate that is too loose to detect.
      #   * the ratio over the same clean stretch (07-29..08-04) held 6.30-6.64,
      #     +/-2.5%, and it is what correctly flagged 08-09 (14.66) as a BH1750
      #     fault rather than a bright day.
      #
      # KNOWN BLIND SPOT — do not oversell this rule. A ratio cannot see
      # COMMON-MODE degradation. 2026-08-05 to 08-08 is the proof: the lamp-window
      # lux halved while the ratio moved only 6.33 -> 7.51, because the AS7341 was
      # fouling alongside the BH1750 (same box, same contamination source). This
      # rule catches DIFFERENTIAL faults. For common-mode, watch the absolute
      # lamp-window medians on the dashboard.
      #
      # Replayed against history before shipping (last hour of in-window data,
      # exactly as the rule computes it):
      #   07-25 3.59 | 08-01 6.40 | 08-04 6.34 | 08-08 7.51   <- healthy
      #   08-09 14.66  BH1750 dying, lux under-reads -> ratio up
      #   08-10 NoData BH1750 at ~0 lux, divide-by-zero guard drops the rows
      #   08-11 0.044 | 08-12 0.050  AS7341 blocked
      #   08-13 1.19 | 08-14 1.41    after the obstruction was removed — still
      #                              ~4.5x below baseline, i.e. NOT yet recovered
      # Band 2.5-12.0 clears every healthy value by >=1.4x and every fault by
      # >=1.2x. RE-DERIVE IT after any optical change (window clean, sensor swap,
      # gain change) — the baseline stepped 1.7x on 07-29 and a stale band is how
      # the old `DLI < 1.5` rule died silently after a lens clean.
      - uid: spectrum-throughput-drift
        title: Spectrometer optical throughput — AS7341 vs BH1750
        condition: C
        # Two sensors, one box: a fault is in one optical path, not in the light.
        for: 30m
        # NoData is not OK here, for the same reason as the deadman above: the
        # query looks back 24 h for samples inside the lamp window, so it has data
        # to chew on at 03:00 just as much as at noon. Nothing to chew on means
        # either the spectrum feed is silent — which NO other rule covers, the
        # sensor deadman watches `air` only — or lux has gone to zero during lamp
        # hours. Both are the failure this rule exists for.
        noDataState: NoData
        execErrState: Error
        labels:
          severity: warning
        annotations:
          summary: 'AS7341 的光學通量偏離基準'
          description: 'AS7341 clear ÷ BH1750 lux = {{ printf "%.2f" $values.B.Value }}，正常區間 2.5–12（健康期實測 6.3–6.6）。兩顆感測器在同一個盒子裡看同一片光，比值只反映光路本身，與光有多亮無關。偏低＝AS7341 這側被遮擋或髒污；偏高＝BH1750 讀不到光。先開盒看石英窗有沒有被東西蓋住。'
        data:
          - refId: A
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: influxdb-monitor-air
            model:
              refId: A
              datasource:
                type: influxdb
                uid: influxdb-monitor-air
              query: |
                import "date"
                import "timezone"
                option location = timezone.location(name: "Asia/Taipei")
                // Inset from the lamp window so the sample never straddles a
                // switching edge or dawn/dusk daylight. Derived from the SAME
                // .env vars the light controller uses, so moving the lamp window
                // moves this with it: 08:00-18:30 -> 09:00-18:00.
                winStart = $LIGHT_WINDOW_START_MIN + 60
                winEnd = $LIGHT_WINDOW_END_MIN - 30
                inWindow = (t) => {
                  m = date.hour(t: t) * 60 + date.minute(t: t)
                  return m >= winStart and m < winEnd
                }
                // 24 h of lookback, not "since now": outside lamp hours this still
                // has the most recent in-window samples to work with, so the rule
                // evaluates around the clock instead of going NoData every night.
                lux = from(bucket: "sensors")
                  |> range(start: -24h)
                  |> filter(fn: (r) => r._measurement == "air" and r.device == "livingroom" and r._field == "lux")
                  |> filter(fn: (r) => inWindow(t: r._time))
                  |> aggregateWindow(every: 10m, fn: median, createEmpty: false)
                  |> keep(columns: ["_time", "_value"])
                  |> rename(columns: {_value: "lux"})
                clear = from(bucket: "sensors")
                  |> range(start: -24h)
                  |> filter(fn: (r) => r._measurement == "spectrum" and r.mode == "ambient" and r.device == "livingroom"
                       and (r._field == "clear" or r._field == "saturated"))
                  |> pivot(rowKey: ["_time"], columnKey: ["_field"], valueColumn: "_value")
                  // A saturated channel is pinned at 65535 and carries no
                  // information about throughput — including it would make a
                  // blocked sensor look healthier the brighter the sun got.
                  // (The PPFD panel omitted this and reported a 1,860 spike from
                  // pinned samples on a day the sensor was mostly blind.)
                  |> filter(fn: (r) => exists r.clear and r.saturated == 0.0 and r.clear < 65535.0)
                  |> filter(fn: (r) => inWindow(t: r._time))
                  |> map(fn: (r) => ({_time: r._time, _value: r.clear}))
                  |> aggregateWindow(every: 10m, fn: median, createEmpty: false)
                  |> keep(columns: ["_time", "_value"])
                  |> rename(columns: {_value: "clear"})
                join(tables: {a: lux, b: clear}, on: ["_time"])
                  // Divide-by-zero guard. A BH1750 reading a flat 0 during lamp
                  // hours drops out here and the rule reports NoData — which
                  // fires, see noDataState. That is 2026-08-10 exactly.
                  |> filter(fn: (r) => r.lux > 0.0)
                  |> map(fn: (r) => ({_time: r._time, _value: r.clear / r.lux}))
                  |> sort(columns: ["_time"])
                  // Last hour of in-window data, median of six 10-min points:
                  // enough to ignore a passing cloud, short enough that the
                  // 2026-08-11 16:00 collapse is visible the same afternoon
                  // (replayed: 0.044 on the day it happened, not the day after).
                  |> tail(n: 6)
                  |> median(column: "_value")
                  // Same shape rules as every other rule in this file: stamp
                  // _time at now() so the point lands inside relativeTimeRange,
                  // and carry the identity as a plain label, never as `_field`.
                  |> map(fn: (r) => ({sensor: "as7341-vs-bh1750", _time: now(), _value: r._value}))
                  |> group(columns: ["sensor"])
          - refId: B
            datasourceUid: __expr__
            model:
              refId: B
              type: reduce
              datasource: {type: __expr__, uid: __expr__}
              expression: A
              reducer: last
          - refId: C
            datasourceUid: __expr__
            model:
              refId: C
              type: threshold
              datasource: {type: __expr__, uid: __expr__}
              expression: B
              conditions:
                - evaluator:
                    # Two-sided: low = the AS7341's path is obstructed, high = the
                    # BH1750's is. One rule, two sensors checking each other.
                    type: outside_range
                    params: [2.5, 12.0]
