apiVersion: 1

# Deadman: one multi-dimensional rule that fires per (device, field) when that
# series hasn't reported for too long. New devices/fields are covered with no
# extra config. Threshold 15 min sits comfortably above the BH1750's transient
# gaps, so this pages only on a genuine sustained outage — the dashboard's 5-min
# table is the fine-grained view.
#
# Annotations are written as SENTENCES, in Chinese, with the number and its unit
# inline. They are the entire notification: the Telegram contact point renders
# summary + description and nothing else, so anything the reader needs has to be
# here. Grafana's default.message (labels dumped as `- k = v`, plus `C=1` from the
# threshold expression) is what this replaces.
#
# The staleness queries below therefore report MINUTES, not seconds. The
# notification template engine has no humanizeDuration — verified against this
# Grafana (11.1.0), which answers `function "humanizeDuration" not defined` — so
# the unit conversion has to happen where the number is produced. The thresholds
# then read in the same unit as the prose (15, 60), which is the point.
groups:
  - orgId: 1
    name: device-health
    folder: Device health
    interval: 1m
    rules:
      - uid: deadman-sensor-stale
        title: Sensor stale — device/field silent
        condition: C
        for: 2m
        # NOT OK. This rule's whole job is to notice silence, so treating "the
        # query returned nothing" as healthy makes it unable to report its own
        # failure — which is exactly what happened: a broken query read as green
        # for weeks while staging-01/temp had been dead 12 days.
        noDataState: NoData
        execErrState: Error
        labels:
          severity: warning
        annotations:
          summary: '{{ $labels.device }} 的 {{ $labels.field }} 停止回報'
          description: '已經 {{ printf "%.0f" $values.B.Value }} 分鐘沒有新資料（門檻 15 分）。檢查裝置電源與感測器接線。'
        data:
          - refId: A
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: influxdb-monitor-air
            model:
              refId: A
              datasource:
                type: influxdb
                uid: influxdb-monitor-air
              query: |
                import "date"
                import "timezone"
                option location = timezone.location(name: "Asia/Taipei")
                minofday = date.hour(t: now()) * 60 + date.minute(t: now())
                from(bucket: "sensors")
                  |> range(start: -30d)
                  // Only continuously-reporting PRODUCTION series belong in a deadman.
                  //   * `sim` is the synthetic publisher.
                  //   * `staging-01` is the bench board — it runs only while someone is
                  //     developing on it, so silence is its normal state, not an outage.
                  //     (Its env fields were one 12-minute bring-up on 2026-07-17 and are
                  //     retired; watching them means a permanent false alarm.)
                  //   * `weight_raw` is event-driven since station Phase 2: a weigh happens
                  //     on an NFC tap (measure/event_raw -> plant_weight), so a gap means
                  //     "nobody weighed anything", not "the scale died". Excluded by field
                  //     so it stays excluded if a production station ever publishes it.
                  // Alert fatigue is how a deadman dies — a rule that always fires is a
                  // rule nobody reads.
                  |> filter(fn: (r) => r._measurement == "air"
                       and r.device != "sim" and r.device != "staging-01"
                       and r._field != "weight_raw")
                  // BH1750 light fields (lux, lux_ref) drop out in darkness, which is
                  // normal — only alert on them inside the plant-light operating
                  // window; other fields 24/7. The window comes from broker/.env
                  // (LIGHT_WINDOW_*_MIN, minutes since midnight) — the SAME vars the
                  // light controller uses, so it stays in sync automatically.
                  |> filter(fn: (r) => (r._field != "lux" and r._field != "lux_ref") or (minofday >= $LIGHT_WINDOW_START_MIN and minofday < $LIGHT_WINDOW_END_MIN))
                  |> group(columns: ["device", "_field"])
                  |> last()
                  // Rebuild each row as a one-point series whose value is the age
                  // in MINUTES (ns / 60e9) — the notification prose quotes this
                  // number directly and there is no unit conversion downstream.
                  // Three things here are load-bearing; each one broke this rule
                  // silently before:
                  //   * `_time` must be present, or Grafana's Flux datasource has no
                  //     series to give the reduce below and yields NoData.
                  //   * `_time` must be now(), NOT the last report time — an old
                  //     point falls outside relativeTimeRange (600s), so the STALEST
                  //     series would be exactly the ones that disappear.
                  //   * the field name must NOT be carried as `_field`: Grafana treats
                  //     that as the frame's field NAME rather than a label, so every
                  //     series from one device collapses to {device=...} and the rule
                  //     dies with "frame cannot uniquely be identified by its labels".
                  //     Carried as plain `field` — annotations use $labels.field.
                  |> map(fn: (r) => ({ device: r.device, field: r._field, _time: now(),
                       _value: float(v: int(v: now()) - int(v: r._time)) / 60000000000.0 }))
                  |> group(columns: ["device", "field"])
          - refId: B
            datasourceUid: __expr__
            model:
              refId: B
              type: reduce
              datasource:
                type: __expr__
                uid: __expr__
              expression: A
              reducer: last
          - refId: C
            datasourceUid: __expr__
            model:
              refId: C
              type: threshold
              datasource:
                type: __expr__
                uid: __expr__
              expression: B
              conditions:
                - evaluator:
                    type: gt
                    # minutes — see the unit note at the top of this file
                    params: [15]

      # Watches the alerting path itself. It cannot warn you WHILE Telegram is down —
      # a single channel can never announce its own failure — so its job is the
      # retrospective one: the moment delivery recovers, this fires and tells you
      # that warnings were raised and lost, and when. On 2026-08-08 that window was
      # five hours and 89 dropped notifications, and the sensor outage underneath it
      # went unnoticed for two days.
      - uid: alert-delivery-failing
        title: Alert delivery failing — notifications are being dropped
        condition: C
        for: 5m
        # OK, unlike the deadman rules — and this one was wrong at first. The two
        # counters carry an `integration` label, so Grafana does not create them
        # until the first notification attempt after a restart: verified on
        # 2026-08-10, /metrics served 220 alerting series while these two were
        # absent entirely. NoData therefore means "Grafana restarted and has not
        # tried to notify yet", which is benign and transient, not a failure.
        # Treating it as an alert would fire after every restart.
        # Scrape health is covered elsewhere: the ingest-completeness panel shows
        # these series going flat if Telegraf stops collecting them.
        noDataState: OK
        execErrState: Error
        labels:
          severity: critical
        annotations:
          summary: '通知送不出去（{{ $labels.integration }}）'
          description: '過去 1 小時有 {{ printf "%.0f" $values.B.Value }} 則通知投遞失敗。這段期間觸發的警報沒有任何人收到 — 回頭查那段時間的 alert 歷史。原因通常是對外網路路徑，不是 token。'
        data:
          - refId: A
            relativeTimeRange:
              from: 3600
              to: 0
            datasourceUid: influxdb-monitor-air
            model:
              refId: A
              datasource:
                type: influxdb
                uid: influxdb-monitor-air
              query: |
                from(bucket: "sensors")
                  |> range(start: -1h)
                  |> filter(fn: (r) => r._measurement == "grafana_alerting_notifications_failed_total")
                  |> filter(fn: (r) => r._field == "counter")
                  |> group(columns: ["integration"])
                  // nonNegative: a Grafana restart zeroes the counter, and without
                  // this that reads as a large negative and the rule goes quiet
                  // exactly when the service has just come back.
                  |> difference(nonNegative: true)
                  |> sum()
                  |> map(fn: (r) => ({ integration: r.integration, _time: now(), _value: r._value }))
                  |> group(columns: ["integration"])
          - refId: B
            datasourceUid: __expr__
            model:
              refId: B
              type: reduce
              datasource: {type: __expr__, uid: __expr__}
              expression: A
              reducer: last
          - refId: C
            datasourceUid: __expr__
            model:
              refId: C
              type: threshold
              datasource: {type: __expr__, uid: __expr__}
              expression: B
              conditions:
                - evaluator:
                    type: gt
                    params: [0]

      # Second deadman, for the one ingest path that is NOT a device: the Open-Meteo
      # poll. It went dark for 11 h on 2026-08-03 and was noticed by eye, because the
      # rule above only covers `air`. Separate rule rather than a broadened filter —
      # the cadence and therefore the threshold are completely different.
      - uid: deadman-weather-stale
        title: Weather feed stale — Open-Meteo
        condition: C
        for: 10m
        # NoData here means the weather measurement has nothing in 30 days, i.e. the
        # feed is not merely late but gone. That must page, not read as healthy.
        noDataState: NoData
        execErrState: Error
        labels:
          severity: warning
        annotations:
          summary: 'Open-Meteo 天氣資料中斷'
          description: '已經 {{ printf "%.0f" $values.B.Value }} 分鐘沒有新的 weather 資料（門檻 60 分）。Telegraf 每 5 分鐘輪詢一次，Open-Meteo 偶發 503，所以這代表持續失敗而不是單次漏接 — 看 docker logs monitor-air-telegraf | grep 503。'
        data:
          - refId: A
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: influxdb-monitor-air
            model:
              refId: A
              datasource:
                type: influxdb
                uid: influxdb-monitor-air
              query: |
                from(bucket: "sensors")
                  |> range(start: -30d)
                  |> filter(fn: (r) => r._measurement == "weather")
                  // The feed is all-or-nothing — one JSON object, every field lands
                  // together — so collapse to ONE series instead of alerting six times
                  // for a single outage. Same shape rules as the rule above: stamp
                  // _time at now(), and never carry the label as `_field`.
                  |> group()
                  |> last()
                  |> map(fn: (r) => ({ feed: "open-meteo", _time: now(),
                       _value: float(v: int(v: now()) - int(v: r._time)) / 60000000000.0 }))
                  |> group(columns: ["feed"])
          - refId: B
            datasourceUid: __expr__
            model:
              refId: B
              type: reduce
              datasource:
                type: __expr__
                uid: __expr__
              expression: A
              reducer: last
          - refId: C
            datasourceUid: __expr__
            model:
              refId: C
              type: threshold
              datasource:
                type: __expr__
                uid: __expr__
              expression: B
              conditions:
                - evaluator:
                    type: gt
                    # minutes. 60 = four missed 15-min slots at a 5-min poll
                    # cadence — well clear of the routine 503s, which now cost
                    # 5 min at most.
                    params: [60]

      # Third deadman, for the feed that can die while its own board stays healthy:
      # the AS7341 ambient spectrum. 2026-08-14 15:44 is why it exists. The chip
      # stopped answering on I2C; spectrumRead() began returning invalid, and
      # mqttPublishSpectrum() drops an invalid reading — so `spectrum` went silent
      # while `air` kept publishing every 15 s from the BME680 and BH1750 on the
      # SAME bus. Nothing alerted, and the reason is that both other rules were
      # looking somewhere else:
      #   * the sensor deadman filters `_measurement == "air"`, and air was perfect.
      #   * the throughput rule below looks back 24 h and takes the last six
      #     in-window samples, so it keeps chewing on yesterday's numbers for a
      #     full day after the feed stops. Its NoData is up to 24 h late.
      # A human noticed, 50 minutes in, by asking. This makes it 15.
      #
      # Replayed against that outage before shipping, the query exactly as it
      # stands with now() pinned to the replay instant:
      #   15:50 (5 min in)   ->  5.2 min   below threshold, silent  <- no false alarm
      #   16:30 (46 min in)  -> 45.2 min   over threshold, fires
      # With `for: 2m` and a 1-min group interval that is a Telegram message at
      # roughly 16:02, against 16:35 for the human who happened to ask.
      - uid: deadman-spectrum-stale
        title: Spectrum feed stale — AS7341 silent
        condition: C
        for: 2m
        # Same reasoning as the sensor deadman: a rule whose entire job is to
        # notice silence must never read its own empty result as healthy.
        noDataState: NoData
        execErrState: Error
        labels:
          severity: warning
        annotations:
          summary: '{{ $labels.device }} 的 AS7341 光譜停止回報'
          description: '已經 {{ printf "%.0f" $values.B.Value }} 分鐘沒有新的 spectrum 資料（門檻 15 分）。修法：用 Tapo app 把名為 sensor 的插座（192.168.50.52）關掉再開。它偶爾會自己好，但不可靠，等不如直接斷電。同一塊板子的 air 很可能還是正常的 — 板子還活著不代表這顆沒事。判讀細節見 PPFD-CALIBRATION.md 的「韌體設定」。'
        data:
          - refId: A
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: influxdb-monitor-air
            model:
              refId: A
              datasource:
                type: influxdb
                uid: influxdb-monitor-air
              query: |
                from(bucket: "sensors")
                  |> range(start: -30d)
                  |> filter(fn: (r) => r._measurement == "spectrum" and r._field == "clear")
                  // `mode` is load-bearing. A reflectance run publishes to the SAME
                  // measurement as mode "reflect" and holds the AS7341 while it goes,
                  // so counting those samples would let an active bench session mask
                  // a dead ambient feed — the one thing this rule is for.
                  |> filter(fn: (r) => r.mode == "ambient")
                  // Same exclusions as the sensor deadman, same reason: staging-01 is
                  // the bench board (last ambient spectrum 2026-08-05) and silence is
                  // its normal state; `sim` is the synthetic publisher.
                  |> filter(fn: (r) => r.device != "sim" and r.device != "staging-01")
                  // One field is enough: the ten channels are a single JSON publish,
                  // they arrive together or not at all. `clear` because it is the
                  // field the throughput rule below already depends on.
                  |> group(columns: ["device"])
                  |> last()
                  // Age in MINUTES — see the unit note at the top of this file. Same
                  // three shape rules as every deadman here: _time stamped at now(),
                  // identity carried as a plain label, never as `_field`.
                  |> map(fn: (r) => ({ device: r.device, _time: now(),
                       _value: float(v: int(v: now()) - int(v: r._time)) / 60000000000.0 }))
                  |> group(columns: ["device"])
          - refId: B
            datasourceUid: __expr__
            model:
              refId: B
              type: reduce
              datasource:
                type: __expr__
                uid: __expr__
              expression: A
              reducer: last
          - refId: C
            datasourceUid: __expr__
            model:
              refId: C
              type: threshold
              datasource:
                type: __expr__
                uid: __expr__
              expression: B
              conditions:
                - evaluator:
                    type: gt
                    # minutes. The ambient tick is every 15 s, so 15 min is 60
                    # missed publishes — the same threshold as the sensor deadman,
                    # and for the same reason: comfortably past any transient.
                    # A reflectance session gates the ambient tick off, but it
                    # gates telemetry off too (main.cpp publishes both behind one
                    # !reflectBusy()), so a session long enough to trip this would
                    # trip the sensor deadman first.
                    params: [15]

      # Between the deadman and the throughput check sits a third state that
      # neither can see: the sensor keeps publishing, on time, and every value is
      # garbage. On 2026-08-22 the AS7341 spent six hours emitting 65535 on every
      # channel every 15 s. The deadman stayed quiet — correctly, it watches for
      # SILENCE and there was none. 932 junk samples, no alert from the rule whose
      # name is about this sensor.
      #
      # spectrum_read_ms is what separates the two, and it does it independently
      # of how much light there is, which no ratio can. A healthy read is two SMUX
      # cycles at ATIME=100/ASTEP=999, so ~610 ms whether it is midnight or noon.
      # A stuck read returns early because the integration never completed.
      #
      # Measured over the 10 days to 2026-08-22, 15-minute medians:
      #   healthy   870 windows, ALL within 608-613 ms   (+/-0.4%, remarkably tight)
      #   stuck      32 windows, highest 414.5 ms
      #   timeout     1 window, 3996 ms
      # Hence a two-sided 500-700 band: 21% clear of the healthy floor, 17% clear
      # of the worst stuck window, and it still catches the timeout mode above.
      # One-sided would have missed 2026-08-16's 7,894 and 17,255 ms reads.
      #
      # The MEDIAN, not the mean: a handful of bad samples in a window is the
      # transient the other two rules already handle and it self-recovers. This
      # rule is for the sustained case, where most of the window is bad. The cost
      # of that choice is symmetric — after a power cycle the window still holds
      # the bad samples, so it keeps firing for up to 15 more minutes. Measured
      # right after the 2026-08-22 fix: recovered reads were 609-611 while the
      # window median still said 434. Do not read a lingering alert as a failed
      # repair; check spectrum_read_ms directly.
      - uid: spectrum-read-time-fault
        title: Spectrum reads are wrong — AS7341 publishing garbage
        condition: C
        for: 5m
        # OK, unlike the two deadmen either side of it. No data is not wrong data:
        # silence is deadman-spectrum-stale's job, and firing both for one fault is
        # how a pager stops being read.
        noDataState: OK
        execErrState: Error
        labels:
          severity: warning
        annotations:
          summary: '{{ $labels.device }} 的 AS7341 讀值不可信'
          description: 'spectrum_read_ms 中位數 {{ printf "%.0f" $values.B.Value }} ms，正常是 610（健康期實測 608–613）。資料還在每 15 秒送，但積分沒跑完，通道會讀出 65535 —— 看起來像被光打滿，其實不是。這種狀態 deadman 抓不到，因為它只看有沒有資料。修法：用 Tapo app 把名為 sensor 的插座（192.168.50.52）關掉再開。判讀細節見 PPFD-CALIBRATION.md 的「韌體設定」。'
        data:
          - refId: A
            relativeTimeRange:
              from: 1200
              to: 0
            datasourceUid: influxdb-monitor-air
            model:
              refId: A
              datasource:
                type: influxdb
                uid: influxdb-monitor-air
              query: |
                from(bucket: "sensors")
                  |> range(start: -15m)
                  |> filter(fn: (r) => r._measurement == "spectrum" and r.mode == "ambient"
                       and r._field == "spectrum_read_ms"
                       and r.device != "sim" and r.device != "staging-01")
                  |> group(columns: ["device"])
                  |> median()
                  // Same three shape rules as every other rule in this file: stamp
                  // _time at now() so the point lands inside relativeTimeRange, and
                  // carry the identity as a plain label, never as `_field`.
                  |> map(fn: (r) => ({ device: r.device, _time: now(), _value: r._value }))
                  |> group(columns: ["device"])
          - refId: B
            datasourceUid: __expr__
            model:
              refId: B
              type: reduce
              datasource:
                type: __expr__
                uid: __expr__
              expression: A
              reducer: last
          - refId: C
            datasourceUid: __expr__
            model:
              refId: C
              type: threshold
              datasource:
                type: __expr__
                uid: __expr__
              expression: B
              conditions:
                - evaluator:
                    # Two-sided: low = integration cut short, high = bus timeout.
                    type: outside_range
                    params: [500, 700]

      # The last failure class: telemetry that ARRIVES, on time, correctly
      # formatted, and is wrong. No deadman above can see it. On 2026-08-10
      # the BH1750 published 4,840 points topping out at 9.2 lux with the lamp on;
      # on 2026-08-11 16:00 the AS7341's visible channels fell ~100x within the
      # hour and stayed there for two days. Both feeds looked perfectly healthy.
      #
      # What makes a plausibility check possible here is that the lamp is a
      # CONTROLLED REFERENCE SOURCE: this site gets almost no daylight (measured
      # 1-2% of the daily total), so during lamp hours the illumination is fixed
      # and known. Two sensors sit in the same box looking at it through their own
      # quartz windows, so their RATIO is a property of the optics alone —
      # independent of how bright the light happened to be.
      #
      # Ratio rather than the absolute reading, and the data decided this:
      #   * absolute `clear` in the lamp window swings with daylight and lamp
      #     runtime — 30,834 (08-04) vs 37,459 (08-09) is +21% of weather, not of
      #     optics. A band loose enough to tolerate that is too loose to detect.
      #   * the ratio over the same clean stretch (07-29..08-04) held 6.30-6.64,
      #     +/-2.5%, and it is what correctly flagged 08-09 (14.66) as a BH1750
      #     fault rather than a bright day.
      #
      # KNOWN BLIND SPOT — do not oversell this rule. A ratio cannot see
      # COMMON-MODE degradation. 2026-08-05 to 08-08 is the proof: the lamp-window
      # lux halved while the ratio moved only 6.33 -> 7.51, because the AS7341 was
      # fouling alongside the BH1750 (same box, same contamination source). This
      # rule catches DIFFERENTIAL faults. For common-mode, watch the absolute
      # lamp-window medians on the dashboard.
      #
      # Replayed against history before shipping (last hour of in-window data,
      # exactly as the rule computes it):
      #   07-25 3.59 | 08-01 6.40 | 08-04 6.34 | 08-08 7.51   <- healthy
      #   08-09 14.66  BH1750 dying, lux under-reads -> ratio up
      #   08-10 NoData BH1750 at ~0 lux, divide-by-zero guard drops the rows
      #   08-11 0.044 | 08-12 0.050  AS7341 blocked
      #   08-13 1.19 | 08-14 1.41    after the obstruction was removed — still
      #                              ~4.5x below baseline, i.e. NOT yet recovered
      # Band 2.5-12.0 clears every healthy value by >=1.4x and every fault by
      # >=1.2x. RE-DERIVE IT after any optical change (window clean, sensor swap,
      # gain change) — the baseline stepped 1.7x on 07-29 and a stale band is how
      # the old `DLI < 1.5` rule died silently after a lens clean.
      - uid: spectrum-throughput-drift
        title: Spectrometer optical throughput — AS7341 vs BH1750
        condition: C
        # Two sensors, one box: a fault is in one optical path, not in the light.
        for: 30m
        # NoData is not OK here, for the same reason as the deadman above: the
        # query looks back 24 h for samples inside the lamp window, so it has data
        # to chew on at 03:00 just as much as at noon. Nothing to chew on means
        # either the spectrum feed has been silent for a whole day — deadman-
        # spectrum-stale catches that in 15 min, this rule would only notice it
        # 24 h later, so treat NoData here as "the deadman was ignored" — or lux
        # has gone to zero during lamp hours. Both are failures worth firing on.
        noDataState: NoData
        execErrState: Error
        labels:
          severity: warning
        annotations:
          summary: 'AS7341 的光學通量偏離基準'
          description: 'AS7341 clear ÷ BH1750 lux = {{ printf "%.2f" $values.B.Value }}，正常區間 2.5–12（健康期實測 6.3–6.6）。兩顆感測器在同一個盒子裡看同一片光，比值只反映光路本身，與光有多亮無關。偏低＝AS7341 這側被遮擋或髒污；偏高＝BH1750 讀不到光。先開盒看石英窗有沒有被東西蓋住。'
        data:
          - refId: A
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: influxdb-monitor-air
            model:
              refId: A
              datasource:
                type: influxdb
                uid: influxdb-monitor-air
              query: |
                import "date"
                import "timezone"
                option location = timezone.location(name: "Asia/Taipei")
                // Inset from the lamp window so the sample never straddles a
                // switching edge or dawn/dusk daylight. Derived from the SAME
                // .env vars the light controller uses, so moving the lamp window
                // moves this with it: 08:00-18:30 -> 09:00-18:00.
                winStart = $LIGHT_WINDOW_START_MIN + 60
                winEnd = $LIGHT_WINDOW_END_MIN - 30
                inWindow = (t) => {
                  m = date.hour(t: t) * 60 + date.minute(t: t)
                  return m >= winStart and m < winEnd
                }
                // 24 h of lookback, not "since now": outside lamp hours this still
                // has the most recent in-window samples to work with, so the rule
                // evaluates around the clock instead of going NoData every night.
                lux = from(bucket: "sensors")
                  |> range(start: -24h)
                  |> filter(fn: (r) => r._measurement == "air" and r.device == "livingroom" and r._field == "lux")
                  |> filter(fn: (r) => inWindow(t: r._time))
                  |> aggregateWindow(every: 10m, fn: median, createEmpty: false)
                  |> keep(columns: ["_time", "_value"])
                  |> rename(columns: {_value: "lux"})
                clear = from(bucket: "sensors")
                  |> range(start: -24h)
                  |> filter(fn: (r) => r._measurement == "spectrum" and r.mode == "ambient" and r.device == "livingroom"
                       and (r._field == "clear" or r._field == "saturated"))
                  |> pivot(rowKey: ["_time"], columnKey: ["_field"], valueColumn: "_value")
                  // A saturated channel is pinned at 65535 and carries no
                  // information about throughput — including it would make a
                  // blocked sensor look healthier the brighter the sun got.
                  // (The PPFD panel omitted this and reported a 1,860 spike from
                  // pinned samples on a day the sensor was mostly blind.)
                  |> filter(fn: (r) => exists r.clear and r.saturated == 0.0 and r.clear < 65535.0)
                  |> filter(fn: (r) => inWindow(t: r._time))
                  |> map(fn: (r) => ({_time: r._time, _value: r.clear}))
                  |> aggregateWindow(every: 10m, fn: median, createEmpty: false)
                  |> keep(columns: ["_time", "_value"])
                  |> rename(columns: {_value: "clear"})
                join(tables: {a: lux, b: clear}, on: ["_time"])
                  // Divide-by-zero guard. A BH1750 reading a flat 0 during lamp
                  // hours drops out here and the rule reports NoData — which
                  // fires, see noDataState. That is 2026-08-10 exactly.
                  |> filter(fn: (r) => r.lux > 0.0)
                  |> map(fn: (r) => ({_time: r._time, _value: r.clear / r.lux}))
                  |> sort(columns: ["_time"])
                  // Last hour of in-window data, median of six 10-min points:
                  // enough to ignore a passing cloud, short enough that the
                  // 2026-08-11 16:00 collapse is visible the same afternoon
                  // (replayed: 0.044 on the day it happened, not the day after).
                  |> tail(n: 6)
                  |> median(column: "_value")
                  // Same shape rules as every other rule in this file: stamp
                  // _time at now() so the point lands inside relativeTimeRange,
                  // and carry the identity as a plain label, never as `_field`.
                  |> map(fn: (r) => ({sensor: "as7341-vs-bh1750", _time: now(), _value: r._value}))
                  |> group(columns: ["sensor"])
          - refId: B
            datasourceUid: __expr__
            model:
              refId: B
              type: reduce
              datasource: {type: __expr__, uid: __expr__}
              expression: A
              reducer: last
          - refId: C
            datasourceUid: __expr__
            model:
              refId: C
              type: threshold
              datasource: {type: __expr__, uid: __expr__}
              expression: B
              conditions:
                - evaluator:
                    # Two-sided: low = the AS7341's path is obstructed, high = the
                    # BH1750's is. One rule, two sensors checking each other.
                    type: outside_range
                    params: [2.5, 12.0]

  # k-model adoption brake (Phase C, blueprint uid=k-alerts). The compute round
  # writes k_event rows deduped by (bucket, event_type, evidence_rev); this rule
  # only relays hold|stale — `resolved` rows are observation-only and explicitly
  # filtered (acceptance: writing a resolved row must NOT fire). Events are
  # sparse by design, so NoData is the healthy state, not a failure.
  - orgId: 1
    name: k-models
    folder: Calibration
    interval: 1m
    rules:
      - uid: k-alerts
        title: k-model adoption needs a human — hold/stale
        condition: C
        for: 1m
        noDataState: OK
        execErrState: Error
        labels:
          severity: warning
        annotations:
          summary: '校正剎車:{{ $labels.target }}/{{ $labels.source }}/{{ $labels.regime }} 有 {{ $labels.event_type }}'
          description: '桶 {{ $labels.target }}/{{ $labels.source }}/{{ $labels.regime }}(epoch {{ $labels.epoch }})過去 1 小時有 {{ printf "%.0f" $values.B.Value }} 筆 {{ $labels.event_type }} 事件。hold = 新估計跳出 ±10% 剎車帶,值已凍結 — 用 broker/ack-k-hold.sh 帶 --evidence-rev 審核(漏登 epoch?);stale = 採納值黏住但參考量測斷供 — 去補 Photone 配對。resolved 事件不觸發本規則。'
        data:
          - refId: A
            relativeTimeRange:
              from: 3600
              to: 0
            datasourceUid: influxdb-monitor-air
            model:
              refId: A
              datasource:
                type: influxdb
                uid: influxdb-monitor-air
              query: |
                from(bucket: "sensors")
                  |> range(start: -1h)
                  // one field only, so each event row counts exactly once
                  |> filter(fn: (r) => r._measurement == "k_event" and r._field == "evidence_rev")
                  |> filter(fn: (r) => r.event_type == "hold" or r.event_type == "stale")
                  |> group(columns: ["target", "source", "regime", "epoch", "event_type", "device"])
                  |> count()
                  // same series-collapse convention as deadman-sensor-stale:
                  // plain label names, _time must exist and be now()
                  |> map(fn: (r) => ({ target: r.target, source: r.source, regime: r.regime,
                       epoch: r.epoch, event_type: r.event_type, device: r.device,
                       _time: now(), _value: float(v: r._value) }))
                  |> group(columns: ["target", "source", "regime", "epoch", "event_type", "device"])
          - refId: B
            datasourceUid: __expr__
            model:
              refId: B
              type: reduce
              datasource: {type: __expr__, uid: __expr__}
              expression: A
              reducer: last
          - refId: C
            datasourceUid: __expr__
            model:
              refId: C
              type: threshold
              datasource: {type: __expr__, uid: __expr__}
              expression: B
              conditions:
                - evaluator:
                    type: gt
                    params: [0]

      # State-driven backstop for the one-shot k_event pings above. The event
      # dedupe (one alert per bucket/type/evidence_rev — spec'd) plus the 1h
      # window means a missed Telegram would leave a held bucket waiting
      # silently forever, and a carry-expired stale bucket's "持續告警" would be
      # a single ping. This rule reads the STATE, not the events: any bucket
      # sitting in held/stale for over 24h keeps firing until the state moves
      # (ack, recovery, or re-earned adoption). 24h so it never doubles the
      # initial event ping — it is the reminder, not the news.
      - uid: k-adoption-stuck
        title: k-model bucket stuck — held/stale unattended
        condition: C
        for: 5m
        noDataState: OK
        execErrState: Error
        labels:
          severity: warning
        annotations:
          summary: '校正桶卡住:{{ $labels.target }}/{{ $labels.source }}/{{ $labels.regime }} {{ $labels.adoption_state }} 超過一天'
          description: '桶 {{ $labels.target }}/{{ $labels.source }}/{{ $labels.regime }}(epoch {{ $labels.epoch }})的採納狀態停在 {{ $labels.adoption_state }} 已 {{ printf "%.0f" $values.B.Value }} 小時。held = 有 pending 值等人審,跑 broker/ack-k-hold.sh;stale = carry 值逾期,去補 Photone 量測讓本 epoch 自己掙到估計。狀態離開 held/stale 本警報就自動解除。'
        data:
          - refId: A
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: influxdb-monitor-air
            model:
              refId: A
              datasource:
                type: influxdb
                uid: influxdb-monitor-air
              query: |
                from(bucket: "sensors")
                  |> range(start: 1970-01-01T00:00:00Z)
                  |> filter(fn: (r) => r._measurement == "k_adopted"
                       and (r._field == "adoption_state" or r._field == "state_since"))
                  |> last()
                  |> pivot(rowKey: ["_time", "target", "source", "regime", "epoch"], columnKey: ["_field"], valueColumn: "_value")
                  |> filter(fn: (r) => r.adoption_state == "held" or r.adoption_state == "stale")
                  // age from state_since, NOT from the row's write time: a held
                  // bucket keeps getting rewritten when new evidence revs land,
                  // and that churn must not reset this clock. state_since moves
                  // only when adoption_state itself changes (kadopt._finish).
                  // Rows from before the field existed fall back to the point's
                  // own _time — time() on a missing/empty string would be a
                  // Flux EXECUTION error, not a quiet skip.
                  // (same series-collapse convention: plain labels, _time now())
                  |> map(fn: (r) => ({ target: r.target, source: r.source, regime: r.regime,
                       epoch: r.epoch, adoption_state: r.adoption_state, _time: now(),
                       _value: float(v: int(v: now()) - int(v:
                         if exists r.state_since and r.state_since != "" then time(v: r.state_since) else r._time)) / 3600000000000.0 }))
                  |> group(columns: ["target", "source", "regime", "epoch", "adoption_state"])
          - refId: B
            datasourceUid: __expr__
            model:
              refId: B
              type: reduce
              datasource: {type: __expr__, uid: __expr__}
              expression: A
              reducer: last
          - refId: C
            datasourceUid: __expr__
            model:
              refId: C
              type: threshold
              datasource: {type: __expr__, uid: __expr__}
              expression: B
              conditions:
                - evaluator:
                    type: gt
                    # hours in state
                    params: [24]
