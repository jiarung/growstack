# Copy to .env and fill in real values. .env is gitignored.
#
# Generate a strong admin token, e.g.:
#   openssl rand -hex 32

# --- InfluxDB first-boot setup (only consumed on the very first start) ---
DOCKER_INFLUXDB_INIT_MODE=setup
DOCKER_INFLUXDB_INIT_USERNAME=admin
DOCKER_INFLUXDB_INIT_PASSWORD=change-me-influx
DOCKER_INFLUXDB_INIT_ORG=monitor-air
DOCKER_INFLUXDB_INIT_BUCKET=sensors
DOCKER_INFLUXDB_INIT_RETENTION=0
DOCKER_INFLUXDB_INIT_ADMIN_TOKEN=replace-with-openssl-rand-hex-32

# --- Grafana ---
GF_SECURITY_ADMIN_PASSWORD=change-me-grafana

# --- Plant-light controller (Tapo P110M) ---
TAPO_EMAIL=you@example.com           # TP-Link account (used for KLAP local auth)
TAPO_PASSWORD=change-me-tapo
TAPO_IP=192.168.1.50                 # P110M LAN IP — set a DHCP reservation
LIGHT_LOCATION=livingroom            # topic segment: monitor-air/<loc>/light/...
LIGHT_SENSOR_DEVICE=sensor-01        # which telemetry device's lux drives the light
LIGHT_TZ=Asia/Taipei                 # window is evaluated in this timezone
MQTT_HOST=mosquitto
# Operating window, minutes since midnight — shared by the light controller AND
# the Grafana lux deadman gate (single source of truth). 480=08:00, 1110=18:30.
LIGHT_WINDOW_START_MIN=480
LIGHT_WINDOW_END_MIN=1110
# Evening top-up: after the base window ends, keep supplementing until today's
# accumulated DLI (from InfluxDB) reaches DLI_TARGET, capped at LIGHT_EXTEND_END_MIN
# (1230=20:30). Controller-only. Re-checked every minute, so the lamp stops as soon
# as the target is met.
#   this lamp delivers ~0.33 mol/h, so the 08:00-18:30 window alone reaches ~3.47
#   <= 3.47 never tops up   ~4.0 tops up most evenings   >= 4.12 always runs to 20:30
# Derive it from YOUR measured baseline, not from horticultural tables — lux/54 is a
# daylight conversion applied to an LED, so the absolute scale is not trustworthy.
LIGHT_EXTEND_END_MIN=1230
DLI_TARGET=4.0

# --- Telegram deadman alert (Grafana) ---
TELEGRAM_BOT_TOKEN=123456:ABC-replace-with-BotFather-token
TELEGRAM_CHAT_ID=123456789           # your numeric chat id (from getUpdates)
# Node-RED bind address (default 127.0.0.1; set to the Tailscale IP for phone access)
NODERED_BIND=127.0.0.1

# --- Open-Meteo weather poll (Telegraf inputs.http, hourly) ---
# Your local coordinates for outdoor rain/cloud/solar context (新北板橋 default).
WEATHER_LAT=25.01
WEATHER_LON=121.46
