 {
  "id": "n-build-ui",
  "type": "function",
  "z": "reflect-flow",
  "name": "build cmd (ui)",
  "func": "const plant = flow.get('plant');\nif (!plant || !/^[A-Za-z0-9_-]{1,40}$/.test(plant)) {\n    node.status({ fill: 'red', shape: 'ring', text: 'pick a plant first' });\n    return [ null, { payload: '(!) pick a plant first' } ];\n}\nconst rid = 'r-' + Date.now().toString(36) + '-' + Math.floor(Math.random()*1e6).toString(36);\nmsg.topic = 'monitor-air/staging-01/reflect/cmd';\nmsg.payload = { request_id: rid, plant: plant, action: 'measure' };\nmsg.qos = 0;\nmsg.retain = false;\nnode.status({ fill: 'green', shape: 'dot', text: plant + ' ' + rid });\nreturn [ msg, null ];",
  "outputs": 2,
  "noerr": 0,
  "initialize": "",
  "finalize": "",
  "libs": [],
  "x": 350,
  "y": 140,
  "wires": [
   [
    "n-mqtt-cmd"
   ],
   [
    "n-txt-result"
   ]
  ]
 },
 {
  "id": "n-mqtt-cmd",
  "type": "mqtt out",
  "z": "reflect-flow",
  "name": "reflect/cmd (non-retained)",
  "topic": "",
  "qos": "0",
  "retain": "false",
  "respTopic": "",
  "contentType": "",
  "userProps": "",
  "correl": "",
  "expiry": "",
  "broker": "mqtt-mosquitto",
