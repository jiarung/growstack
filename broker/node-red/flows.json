  "y": 140,
  "wires": []
 },
 {
  "id": "n-http-in",
  "type": "http in",
  "z": "reflect-flow",
  "name": "POST /reflect/measure",
  "url": "/reflect/measure",
  "method": "post",
  "upload": false,
  "swaggerDoc": "",
  "x": 150,
  "y": 240,
  "wires": [
   [
    "n-build-http"
   ]
  ]
 },
 {
  "id": "n-build-http",
  "type": "function",
  "z": "reflect-flow",
  "name": "build cmd (http)",
  "func": "const plant = (msg.payload && msg.payload.plant) || (msg.req && msg.req.query && msg.req.query.plant) || '';\nif (!/^[A-Za-z0-9_-]{1,40}$/.test(plant)) {\n    msg.statusCode = 400;\n    msg.payload = { error: 'plant required: ?plant=<id> or JSON body, [A-Za-z0-9_-] 1-40 chars' };\n    return [ null, msg ];\n}\nconst rid = 'r-' + Date.now().toString(36) + '-' + Math.floor(Math.random()*1e6).toString(36);\nconst cmd = { topic: 'monitor-air/staging-01/reflect/cmd', payload: { request_id: rid, plant: plant, action: 'measure' }, qos: 0, retain: false };\nmsg.payload = { status: 'accepted', request_id: rid, plant: plant };\nmsg.statusCode = 202;\nreturn [ cmd, msg ];",
  "outputs": 2,
  "noerr": 0,
  "initialize": "",
  "finalize": "",
  "libs": [],
  "x": 400,
  "y": 240,
  "wires": [
   [
    "n-mqtt-cmd"
   ],
   [
    "n-http-res"
   ]
  ]
 },
 {
  "id": "n-http-res",
  "type": "http response",
  "z": "reflect-flow",
  "name": "202 accepted",
  "statusCode": "",
  "headers": {},
  "x": 650,
  "y": 260,
  "wires": []
 },
