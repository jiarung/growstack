.DS_Store
.pio
.cache
compile_commands.json
.vscode/
.env
tmp/
*.jpg

# Secrets — real credentials live in src/secrets.h (use secrets.h.example as template)
src/secrets.h

# Broker stack secrets (use broker/.env.example as template)
broker/.env

# Personal progress journal — kept local, not for the public repo
docs/PROGRESS.md

# Internal planning / lessons — kept local, not for the public repo
# Scratch notes and working plans. Anything the CODE cites as its
# contract belongs in docs/ instead — a doc that ships nowhere left
# five modules pointing at a file the repo did not contain.
tasks/

# Rendered from rules.yaml.tmpl by broker/start.sh (bakes LIGHT_WINDOW_* from .env)
broker/grafana/provisioning/alerting/rules.yaml

# Photone CAL recording audit log (runtime data, per-host). Glob, not a literal
# path: record-photone.sh rotates a file whose header has aged out to
# photone-log.pre-<stamp>.csv, and those rotations are runtime data too.
broker/photone-log*.csv

# Written daily by the influx-backup cron (see broker/README.md)
broker/backup/backup.log

# Python bytecode (solar-noon.py gets imported by tests)
__pycache__/
*.pyc
broker/epochs.json.lock
.codex/

# Claude Code session state — settings plus whole worktree copies (11 MB)
.claude/
broker/fixtures/out/
